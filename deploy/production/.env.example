# Mooi production environment. Lives on the server next to the releases (<MOOI_DEPLOY_DIR>/.env),
# never in the repository. Generate every secret with `openssl rand -base64 32`.

# Public host. DNS: <DOMAIN> must resolve to the Traefik host (previews live under its /preview/).
DOMAIN=mooi.skypea.dev
# Persistent data root (postgres, workspaces, speech runtime/model, ssh identity)
DATA_DIR=/mnt/primary-0/mooi
# Group id owning /var/run/docker.sock on the host (`getent group docker`)
DOCKER_GID=983

# Database
POSTGRES_PASSWORD=change-me

# Secrets
JWT_SECRET=change-me-at-least-32-bytes
SECRETS_KEY=change-me-base64-32-bytes
SERVICE_TOKEN=change-me-at-least-32-bytes

# Google OAuth2 (authorized JavaScript origin: https://<DOMAIN>)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
ADMIN_EMAILS=

# GitHub App (callback URL: https://<DOMAIN>/account/github/callback)
GITHUB_CLIENT_ID=Iv23liYourGithubAppClientId
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_SLUG=your-github-app-slug

# Gemini CLI sign-in (Google OAuth2 + PKCE, code pasted back from Google's Code Assist page): the Gemini
# CLI's installed-app OAuth client id and secret (OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET in the open-source
# Gemini CLI, packages/core/src/code_assist/oauth2.ts). Never commit them: the sign-in is offered only
# once both are set; empty leaves Gemini to API keys alone.
AGENT_GEMINI_CLIENT_ID=
AGENT_GEMINI_CLIENT_SECRET=

# Optional tuning (defaults shown)
# MAX_SESSIONS=8
# MAX_SESSIONS_PER_PLAYER=4
# SESSION_IDLE_TIMEOUT_MINUTES=180
# MAX_DEPLOYMENTS=4
# AGENT_CLAUDE_MODEL=sonnet
# AGENT_CLAUDE_EFFORT=high
# AGENT_GEMINI_ENABLED=true
# AGENT_GEMINI_TOKEN_REFRESH_SKEW=10m
# AGENT_GEMINI_MODEL=auto
# SPEECH_LANGUAGE=es-ES
# SPEECH_CONTEXTS=
# SPEECH_MAX_SECONDS=300
# MIC_MOOI_MEMORY=1g
# LOG_LEVEL=INFO
# LOG_LEVEL_APP=INFO
